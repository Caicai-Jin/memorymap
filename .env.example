# Copy this file to .env and fill in real values before running `docker compose up`.
# .env itself is gitignored — never commit it.

# Password for the Postgres container Docker Compose creates for you (pick anything).
DB_PASSWORD=

# Base64-encoded secret for signing JWTs. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# From your Cloudinary dashboard (cloudinary.com) — free tier, no card required.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
